# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Any OpenAI-compatible endpoint's API key (for the text/narration LLM)
LLM_API_KEY=your_llm_api_key_here

# Base URL of the OpenAI-compatible chat endpoint. Examples:
#   OpenAI:        https://api.openai.com/v1
#   OpenRouter:    https://openrouter.ai/api/v1
#   Groq:          https://api.groq.com/openai/v1
#   Local Ollama:  http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1

# Model name as expected by that endpoint (used for main turn narration)
LLM_MODEL=gpt-4o-mini

# Optional: lightweight model for background utility tasks (bounty boards, merchant stock, next story quest payload)
# Examples: google/gemini-2.5-flash-lite, gpt-4o-mini
# When left empty/unset, defaults to LLM_MODEL above.
LLM_UTILITY_MODEL=

# Optional: comma-separated list of fallback models tried in sequence if LLM_MODEL fails/times out
# LLM_FALLBACK_MODELS=google/gemini-2.5-flash,openrouter/auto

# ---------------------------------------------------------------- NSFW LLM (optional)
# Separate provider used only for NSFW scenarios (e.g. OpenRouter with a permissive
# open-weights model like Midnight Miqu, MythoMax, or Llama 3 fine-tunes).
# When not set, NSFW scenarios fall back to the default LLM above — no hard failure.
#
# Example (OpenRouter):
#   NSFW_LLM_API_KEY=sk-or-v1-...
#   NSFW_LLM_BASE_URL=https://openrouter.ai/api/v1
#   NSFW_LLM_MODEL=gryphe/mythomax-l2-13b
NSFW_LLM_API_KEY=
NSFW_LLM_BASE_URL=
NSFW_LLM_MODEL=

# Optional: lightweight model for NSFW background utility tasks. Defaults to NSFW_LLM_MODEL if unset.
NSFW_LLM_UTILITY_MODEL=

# Optional: comma-separated list of fallback models for NSFW scenarios
# NSFW_LLM_FALLBACK_MODELS=nousresearch/hermes-3-llama-3.1-405b

# Timeout per request attempt (seconds) before trying the next fallback model
# Recommended: 300.0 for slower/open-weights models, 30.0-60.0 for fast API models
LLM_REQUEST_TIMEOUT=300.0

# Dynamic multi-pass turn engine settings
# Enable dynamic 2-pass system for complex turns (crit fails, travel, multi-NPC summits, quest milestones)
ENABLE_DYNAMIC_MULTIPASS=true
# Application-level deadlines for passes (seconds)
# Pass 1 only generates ~80 tokens; 15-45s gives ample headroom
LLM_PASS1_TIMEOUT=45.0
# Pass 2 generates full story prose and choices; recommended 300.0 for open-weights / Nano-GPT, 35.0-60.0 for fast APIs
LLM_PASS2_TIMEOUT=300.0

# Sampling temperature settings (0.0 to 1.0)
# Standard models (e.g. GPT-5.6 / Claude): 0.85 (rich creative narrative)
LLM_TEMPERATURE=0.85
# NSFW / open-weights models (e.g. Gemma 4 31B, Llama-3): 0.65 (optimal roleplay prose & JSON formatting stability)
NSFW_LLM_TEMPERATURE=0.65

# Maximum concurrent LLM requests allowed simultaneously (defaults to 4)
LLM_MAX_CONCURRENCY=4
# SSL verification for LLM endpoints (defaults to true; set to false only for local self-signed dev servers)
LLM_VERIFY_SSL=true

DB_PATH=hikayat.db

# Comma-separated channel IDs to restrict the bot to. Leave empty to run in all channels the bot can see.
ALLOWED_CHANNEL_IDS=

# Comma-separated channel IDs to exclude. If ALLOWED_CHANNEL_IDS is empty,
# the bot runs in every channel EXCEPT these. Ignored if ALLOWED_CHANNEL_IDS is set.
DISALLOWED_CHANNEL_IDS=


# ---------------------------------------------------------------- image gen
# Optional. Leave IMAGE_ROUTER_API_KEY blank to disable image generation
# entirely (players can still flip the /settings image_generation toggle,
# it just won't do anything until this is set).
IMAGE_ROUTER_API_KEY=
IMAGE_ROUTER_BASE_URL=https://api.imagerouter.io/v1/openai/images/generations
# Check https://imagerouter.io/models for the current model catalog/slugs.
IMAGE_ROUTER_MODEL=black-forest-labs/flux-2-klein-9b
